# CRM/n8n authentication. Preserve the existing value when moving or deploying.
# Configure the same Bearer token in n8n's HTTP credential.
N8N_WEBHOOK_SECRET=
# Supabase Auth (public browser/session configuration; NEVER a secret/service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Business signup, private workspace migration and SMTP: docs/business-accounts-and-hosting.md.
# Existing ClearFlow staff access: docs/login-and-assistant.md.
# Gemini assistant reads private workspace configuration (Supabase or local .data).
# Optional server-only overrides for another deployment:
# GEMINI_ASSISTANT_API_KEY=
# GEMINI_ASSISTANT_MODEL=
# Defaults to this application's .data directory. Keep outside a public/static folder.
# CRM_DATA_DIR=C:/path/to/private/crm-data

# Supabase CRM database + private files. Keep local until SQL/import is verified.
# Vercel requires supabase and never falls back to a local seeded workspace.
CRM_STORAGE_BACKEND=local
# Server-only secret key from the SAME Supabase project; NEVER NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# Optional server URL override; defaults to NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=

# Optional production inquiry form URL shown in Settings > Customer inquiry form.
# Otherwise read from private workspace configuration in Supabase or local .data.
# Use the active form's production address; localhost is only usable on that computer.
# CRM_CUSTOMER_FORM_URL=https://forms.yourbusiness.com/form/your-form-id

# Optional customer photos from the business owner's Google Contacts.
# Requires People API and read-only Contacts + Other Contacts authorization.
# The maintainer setup script can install this privately without changing this file.
# Server-only credentials; never use NEXT_PUBLIC_ prefixes. See docs/customer-photos.md.
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CONTACTS_REFRESH_TOKEN=

# Customer Google connection onboarding. Disabled until the additive connection
# SQL migrations, approved Google OAuth app and n8n connection are configured.
# A private env file on this PC is not deployed by Git. Add its server values in
# Vercel Project Settings > Environment Variables > Production, then redeploy.
# Never commit Google secrets or the private vercel-production.env file.
CRM_GOOGLE_CONNECTIONS_ENABLED=false
# Stable Production origin; never use a temporary protected deployment URL.
# CRM_PUBLIC_ORIGIN=https://your-production-domain.example
# Google Web application OAuth client. Callback: /api/connections/google/callback.
# CRM_GOOGLE_CLIENT_ID=
# CRM_GOOGLE_CLIENT_SECRET=
# Random 32-byte base64 encryption key, backed up privately and retained on redeploy.
# CRM_CONNECTION_ENCRYPTION_KEY=
# Public Vercel + existing local Docker: pull. See docs/local-docker-multi-user.md.
# The operator API key remains only inside Docker, not on Vercel in pull mode.
# CRM_N8N_CONNECTION_MODE=pull
# CRM_N8N_WORKER_KEY=
# CRM_N8N_WORKER_ID=
# Hosted operator n8n origin and server-only API key. Never expose to browsers.
# These three values apply only to direct mode (the default).
# CRM_N8N_API_URL=https://your-automation-domain.example
# CRM_N8N_API_KEY=
# Shared only with the operator's hosted credential-import helper.
# CRM_N8N_SETUP_KEY=
# Operator-approved existing Gemini Header Auth credential and model.
# CRM_N8N_GEMINI_CREDENTIAL_ID=
# CRM_N8N_GEMINI_MODEL=
