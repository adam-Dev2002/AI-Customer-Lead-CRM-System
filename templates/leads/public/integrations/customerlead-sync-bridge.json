      "id": "e6a85d25-9d75-4f42-b508-fa812199e381",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "parameters": {
        "content": "# CustomerLead sync bridge\nInactive until you configure it. Set the spreadsheet ID below. Prepare Leads + ReplyReviews headers using the connection guide. Select CRM Header Auth and Google credentials. Run ONE bridge execution at a time.\n\nThis workflow writes Sheets and updates existing plain-text Gmail drafts. It has NO email send operation. Manual CRM drafts are recorded in ReplyReviews for review in Gmail. Import the event adapters into the original automation separately.",
        "height": 300,
        "width": 560
      },
      "position": [
        -300,
        -420
      ]
    },
