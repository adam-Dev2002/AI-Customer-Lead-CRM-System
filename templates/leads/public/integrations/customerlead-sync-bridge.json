    {
      "id": "6bb5a321-cf6a-4411-a8cc-26218b9046ea",
      "name": "Read Gmail draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/drafts/' + encodeURIComponent($('Loop changes').item.json.payload.Gmail_Draft_ID) + '?format=full' }}",
        "authentication": "predefinedCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "nodeCredentialType": "gmailOAuth2"
      },
      "position": [
