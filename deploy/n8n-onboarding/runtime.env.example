# Private values, never commit runtime.env or the state volume.
# The same setup key is CRM_N8N_SETUP_KEY on the website (32+ random characters).
CUSTOMERLEAD_SETUP_KEY=
# Existing n8n project that owns the operator API key and approved Gemini credential.
CUSTOMERLEAD_OPERATOR_PROJECT_ID=
# Retain any existing encryption/database runtime settings privately.
# Do not generate a replacement N8N_ENCRYPTION_KEY during a restore.
