# Copy to .env privately on the server. Blank required values prevent startup.
# Use two available DuckDNS names, or two hostnames under a domain you own.
CRM_HOST=
N8N_HOST=
ACME_EMAIL=
# Public Supabase settings must match during the Docker build and at runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Preserve this value from the local private .env.local; never create a new one during migration.
N8N_WEBHOOK_SECRET=
# Preserve the existing Form Trigger's webhook/form ID.
CRM_FORM_ID=
